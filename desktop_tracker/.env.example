# LifeOS Desktop Tracker — Environment Variables
# Copy this file to .env and fill in your credentials.
# The .env file is gitignored and never committed.

# Your LifeOS account credentials
LIFEOS_EMAIL=your_email@example.com
LIFEOS_PASSWORD=your_password

# URL of your running FastAPI backend (no trailing slash)
LIFEOS_API_URL=http://localhost:8000/api
